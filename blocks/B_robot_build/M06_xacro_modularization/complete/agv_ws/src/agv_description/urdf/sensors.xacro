<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="fixed_sensor" params="name parent xyz rpy size">
    <link name="${name}_link">
      <visual><geometry><box size="${size}"/></geometry><material name="sensor_black"/></visual>
      <collision><geometry><box size="${size}"/></geometry></collision>
      <inertial><mass value="0.05"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
    </link>
    <joint name="${name}_joint" type="fixed"><parent link="${parent}"/><child link="${name}_link"/><origin xyz="${xyz}" rpy="${rpy}"/></joint>
  </xacro:macro>
</robot>
