<?xml version="1.0"?>
<robot name="agv" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find agv_description)/urdf/common.xacro"/>
  <xacro:include filename="$(find agv_description)/urdf/wheels.xacro"/>
  <xacro:include filename="$(find agv_description)/urdf/sensors.xacro"/>

  <xacro:property name="body_length" value="0.60"/>
  <xacro:property name="body_width" value="0.42"/>
  <xacro:property name="body_height" value="0.16"/>
  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_width" value="0.05"/>
  <xacro:property name="wheel_base" value="0.38"/>

  <link name="base_footprint"/>
  <link name="base_link">
    <visual><origin xyz="0 0 ${wheel_radius + body_height/2}"/><geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry><material name="agv_blue"/></visual>
    <collision><origin xyz="0 0 ${wheel_radius + body_height/2}"/><geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry></collision>
    <xacro:box_inertia mass="12.0" x="${body_length}" y="${body_width}" z="${body_height}"/>
  </link>
  <joint name="base_footprint_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/></joint>

  <xacro:agv_wheel side="left" y="${wheel_base/2}" radius="${wheel_radius}" width="${wheel_width}"/>
  <xacro:agv_wheel side="right" y="${-wheel_base/2}" radius="${wheel_radius}" width="${wheel_width}"/>

  <link name="caster_link"><visual><geometry><sphere radius="0.04"/></geometry><material name="wheel_gray"/></visual><collision><geometry><sphere radius="0.04"/></geometry></collision><inertial><mass value="0.15"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial></link>
  <joint name="caster_joint" type="fixed"><parent link="base_link"/><child link="caster_link"/><origin xyz="-0.24 0 0.04"/></joint>

  <xacro:fixed_sensor name="lidar" parent="base_link" xyz="0.12 0 ${wheel_radius + body_height + 0.04}" rpy="0 0 0" size="0.09 0.09 0.05"/>
  <xacro:fixed_sensor name="camera" parent="base_link" xyz="0.28 0 ${wheel_radius + body_height + 0.04}" rpy="0 0 0" size="0.05 0.08 0.05"/>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed"><parent link="camera_link"/><child link="camera_optical_frame"/><origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/></joint>
  <xacro:fixed_sensor name="imu" parent="base_link" xyz="0 0 ${wheel_radius + body_height + 0.02}" rpy="0 0 0" size="0.03 0.03 0.02"/>
</robot>
